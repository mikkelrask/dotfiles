{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 3,
  "exclusive": true,
  "gtk-layer-shell": false,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
    "custom/logo",
    "ext/workspaces",
    "custom/sep",
    "dwl/window#title",
  ],
  "modules-center": [
    "custom/nowplaying"
  ],
  "modules-right": [
    "network",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "battery",
    "custom/sep",
    "tray",
    "clock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "  ",
      "2": " ",
      "3": " 󰭹 ",
      "4": " 󰈙 ",
      "5": "  ",
      "6": "󰧨 ",
      "7": " 󱎓 ",
      "8": "   ",
      "9": "   "
    }
  },
  "battery": {
    "format": "{icon} {capacity}% ",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 8,
  },
  "clock#simpleclock": {
    "tooltip": false,
    "format": "  {:%H:%M}",
  },
  "clock": {
    "format": "  {:L%a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "sort-by-id": true,
    "format-icons": {
      
      "1": "",
      "2": " ",
      "3": " 󰭹 ",
      "4": " 󰈙 ",
      "5": "  ",
      "6": " 󰧨 ",
      "7": " 󱎓 ",
      "8": "  ",
      "9": "  "
     /* 
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
      */
      }
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "interval": 1,
  },
  "memory": {
    "format": "  {used:0.2f}G",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "headphone": " ",
      "hands-free": "󰂑",
      "headset": "󰂑",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        " ",
        " ",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/logo": {
    "format": " ",
    "on-click": "/home/mr/.config/rofi/launchers/type-6/launcher.sh",
    "tooltip": false
  },
  "custom/sep": {
    "format": "|",
    "tooltip": false
  },
  "custom/power": {
    "tooltip": true,
    "on-click": "hyprexit.sh",
    "format": "⏻ "
  },
  "dwl/window#layout": {
    "format": "[{layout}]"
  },
  "custom/nowplaying": {
    "exec": "~/.config/waybar/scripts/nowplaying.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": true
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
    "format-linked": "{ifname} (No IP) ",
    "format": "",
    "format-disconnected": "",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "on-click-right": "ghostty  --title='nm' --config-file=$HOME/.config/ghostty/borderless -e impala",
    "tooltip-format": " {bandwidthUpBits}  {bandwidthDownBits}\n{ifname}\n{ipaddr}/{cidr}\n",
    "tooltip-format-wifi": " {essid} {frequency}MHz\nStrength: {signaldBm}dBm ({signalStrength}%)\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}",
    "interval": 10
},

}
