#!/usr/bin/env bash

REPO=$(basename "$(git rev-parse --show-toplevel)")
MSG=$(git log -1 --pretty=%B)

NOTE="$HOME/.brain/diary/$(date +%Y/%m/%Y-%m-%d).md"

mkdir -p "$(dirname "$NOTE")"

echo ""
echo "### $(date +%H:%M):  " >> "$NOTE"

# wrap multi-line commit in a fenced code block
echo '```' >> "$NOTE"
echo "($REPO) $MSG" >> "$NOTE"
echo '```' >> "$NOTE"
