[global]
    font = CaskaydiaCove NF
    layer = top
    markup = full
    format = "<b>%s</b>\n%b"
    transparency = 10
    corner_radius = 8
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#3d59a1"         # tokyo_night_blue
    separator_color = frame
    idle_threshold = 120
    word_wrap = yes
    ignore_newline = no
    offset = (0,20)
    width = 530
    alignment = center
    vertical_alignment = center
    icon_position = left
    max_icon_size = 120
    sticky_history = no
    history_length = 20
    show_indicators = no
    always_run_script = false
    title = Dunst
    class = Dunst
    enable_recursive_icon_lookup = true
    sort = yes
    indicate_hidden = yes
    shrink = no
    monitor = 1
    origin = top-center
    follow = none
    min_icon_size = 48

[urgency_low]
    background = "#1a1b26"          # tokyo_night_bg
    foreground = "#a9b1d6"          # tokyo_night_fg
    timeout = 5
    frame_color = "#3d59a1"         # tokyo_night_blue

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"          # slightly brighter fg
    timeout = 7
    frame_color = "#7aa2f7"         # tokyo_night_blue2

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"          # tokyo_night_red
    timeout = 0
    frame_color = "#f7768e"
    layer = overlay
