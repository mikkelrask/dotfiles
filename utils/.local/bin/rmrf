#!/bin/bash

TARGET_DIR="$1"

# Check if a directory argument is provided
if [ -z "$TARGET_DIR" ]; then
  echo "Usage: $0 <directory>"
  exit 1
fi

# Check if the argument is actually a directory
if [ ! -d "$TARGET_DIR" ]; then
  echo "Error: '$TARGET_DIR' is not a directory."
  exit 1
fi

# Check if the directory is empty
if [ -z "$(ls -A "$TARGET_DIR")" ]; then
  # Directory is empty, delete it silently
  rm -rf "$TARGET_DIR"
else
  # Directory is not empty, list files and prompt
  echo "Directory '$TARGET_DIR' is not empty. It contains:"
  ls -A "$TARGET_DIR"
  echo ""
  read -p "Are you sure you want to delete '$TARGET_DIR' and all its contents? (y/N) " -n 1 -r
  echo ""
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    rm -rf "$TARGET_DIR"
    echo "Deleted '$TARGET_DIR'."
  else
    echo "Operation cancelled."
  fi
fi