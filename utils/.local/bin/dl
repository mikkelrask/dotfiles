#!/usr/bin/env bash
set -euo pipefail

music_dir="/mnt/pool/Music"
yt_dlp_urls=("bandcamp.com" "youtube.com" "soundcloud.com")

dl() {
  local url="$1"
  local use_yt_dlp=false

  for pattern in "${yt_dlp_urls[@]}"; do
    if [[ "$url" == *$pattern* ]]; then
      use_yt_dlp=true
      break
    fi
  done

  if $use_yt_dlp; then
    start_dir=$(pwd)
    echo "[INFO] Media link detected - downloading using yt-dlp"
    read -rp "Artist: " artist
    read -rp "Album: " album
    read -rp "Year: " year
    read -rp "URL to album art work (leave empty to skip): " cover_url

    target_dir="$music_dir/${artist}/${album}"
    mkdir -p "$target_dir"
    cd "$target_dir" || exit 1

    if [[ -n "$cover_url" ]]; then
      wget -cq --progress bar -O "cover.jpg" "$cover_url"
    fi

    album_safe="${album//\'/\'\\\'\'}"

    echo "[INFO] Downloading with yt-dlp..."

    if ! yt-dlp \
      --cookies "$HOME/.config/yt-dlp/www.youtube.com_cookies.txt" \
      -x --audio-format mp3 --audio-quality 0 \
      --add-metadata \
      --metadata-from-title "%(artist)s - %(title)s" \
      --ppa "EmbedMetadata:-metadata album='$album_safe' -metadata date=$year -metadata artist='$artist'" \
      -o "%(playlist_index)02d - %(title)s.%(ext)s" \
      "$url"; then
      echo "[ERROR] yt-dlp failed to download the file(s)."
      cd "$start_dir" && exit 1
    fi

    for media in *.mp3; do
      echo "[INFO] Checking $media"

      title_check=$(ffprobe -v error -show_entries format_tags=title -of default=noprint_wrappers=1:nokey=1 "$media")
      album_check=$(ffprobe -v error -show_entries format_tags=album -of default=noprint_wrappers=1:nokey=1 "$media")

      if [[ -z "$title_check" || -z "$album_check" ]]; then
        echo "[INFO] Missing title or album, re-tagging full metadata..."

        new_title="${media%.*}"
        total_tracks=$(find . -maxdepth 1 -type f -iname "*.mp3" | wc -l)
        track_num=$(echo "$media" | grep -oE '^[0-9]+' || echo 0)

        tmp_output=$(mktemp --suffix=.mp3)

        if [[ -f "cover.jpg" ]]; then
          ffmpeg -y -i "$media" -i "cover.jpg" \
            -map 0 -map 1 -c copy -id3v2_version 3 \
            -metadata title="$new_title" \
            -metadata album="$album" \
            -metadata album_artist="$artist" \
            -metadata date="$year" \
            -metadata track="$track_num/$total_tracks" \
            -disposition:v:0 attached_pic \
            "$tmp_output" &>/dev/null
        else
          ffmpeg -y -i "$media" -c copy -id3v2_version 3 \
            -metadata title="$new_title" \
            -metadata album="$album" \
            -metadata album_artist="$artist" \
            -metadata date="$year" \
            -metadata track="$track_num/$total_tracks" \
            "$tmp_output" &>/dev/null
        fi

        if [[ -f "$tmp_output" ]]; then
          mv "$tmp_output" "$media"
          echo "[INFO] Re-tagging complete."
        else
          echo "[ERROR] ffmpeg tagging failed for $media"
        fi
      else
        echo "[INFO] Title and album present, checking artist and cover..."

        tmp_output=$(mktemp --suffix=.mp3)

        if [[ -f "cover.jpg" ]]; then
          ffmpeg -y -i "$media" -i "cover.jpg" \
            -map 0 -map 1 -c copy -id3v2_version 3 \
            -metadata album_artist="$artist" \
            -metadata album_artist="$artist" \
            -disposition:v:0 attached_pic \
            "$tmp_output" &>/dev/null
        else
          ffmpeg -y -i "$media" -c copy -id3v2_version 3 \
            -metadata album_artist="$artist" \
            "$tmp_output" &>/dev/null
        fi

        if [[ -f "$tmp_output" ]]; then
          mv "$tmp_output" "$media"
          echo "[INFO] Artist (and cover) update done."
        else
          echo "[ERROR] ffmpeg artist update failed for $media"
        fi
      fi
    done
    

    cd "$start_dir" && exit 0
  else
    echo "[INFO] Downloading $url"
    wget -cq --progress bar "$url"
  fi
}

dl "$@"
