#!/usr/bin/env bash

music_dir="/pool/Music"

yt_dlp_urls=(
  "*bandcamp.com*"
  "*youtube.com*"
  "*soundcloud.com*"
)

eyed3_check() {
  if ! command -v eyeD3 &>/dev/null; then
    notag=true
  fi
}


set_title() {
  basename "$1" "${1##*.}"
}
export -f set_title

remove_id_inside_brackets() {
  local title="$1"
  echo "${title//\[[0-9]*\]/}"
}
dl() {
  local url="$1"
  local use_yt_dlp=false

  for pattern in "${yt_dlp_urls[@]}"; do
    if [[ "$url" == *$pattern* ]]; then
      use_yt_dlp=true
      break
    fi
  done

  if $use_yt_dlp; then
    start_dir=$(pwd)
    echo "[INFO] Media link detected - downloading using yt-dlp"
    read -rp "Artist: " artist
    read -rp "Album: " album
    if [ -d "$music_dir/${artist}/${album}" ]; then
      echo "Album directory already exists."
      read -rp "Do you want to overwrite it? (y/n): " overwrite
      [ "$overwrite" != "y" ] && cd "$start_dir" && exit 0
    elif [[ ! -d "$music_dir/${artist}/${album}" ]]; then
      mkdir -pv "$music_dir/${artist}/${album}"
    fi
    cd "$music_dir/${artist}/${album}" || exit 1
    read -rp "Year: " year
    read -rp "URL to album art work (leave empty to skip): " cover_url
    [ "$cover_url" ] && wget -cq --progress bar -O "$music_dir/${artist}/${album}/cover.jpg" "$cover_url"
    echo "[INFO] Downloading ..."
    if ! yt-dlp -x "$@" --audio-quality 0 --quiet --progress -o "$music_dir/${artist}/${album}/%(title)s.%(ext)s"; then
      echo "[ERROR] yt-dlp failed to download the file(s)."
      cd "$start_dir" || exit 1
      exit 1
    fi

    ## Tagging
    [[ -z "$notag" ]] && exit 0

    # Convert to mp3
    echo "[INFO] Converteing opus media to mp3..."
    convert.sh opus mp3 &>/dev/null || (echo "[ERROR] Something went wrong converting media files ..." && exit 1)
    read -rp "Do you wish to clean up the source media files? (y/n) " clean
    if [[ "$clean" == "y" ]]; then
	echo "[INFO] Deleting *.opus ..."
	rm ./*.opus
    fi


    # Find all supported files and tag them with eyeD3
    echo "[INFO] Tagging media files ..."
    ((number=1))
    for media in *.mp3; do
      # Skip if no files match (glob fails)
      [[ -e "$media" ]] || continue
      
      # Extract new title (strip extension, optional custom function can be used)
      new_title="${media%.*}"
      (( total_tracks=$(find ./*.mp3 | wc -l) ))
      
      # Apply tags using eyeD3
      echo "[$number] $artist - $new_title, $album"
      
      if ! /usr/bin/eyeD3 --add-image="./cover.jpg:FRONT_COVER" \
            -a "$artist" \
            -A "$album" \
            -b "$artist" \
            -Y "$year" \
            -t "$new_title" \
            -n "$number" \
            -N "$total_tracks" \
            "$media" + &>/dev/null; then
        echo "Error: eyeD3 failed to tag file: $media"
        cd "$start_dir" && exit 1
      fi
      
      ((number++))
    done

    cd "$start_dir" && exit 0
  else
    echo "[INFO] Downloading $1"
    wget -cq --progress bar "$@"
  fi
}

# Call the function with command line arguments
dl "$@"
