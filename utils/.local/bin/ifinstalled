#!/usr/bin/env bash
G

DISTRO=$(lsb_release -si)
#echo "$DISTRO"

function arch {
	for x in "$@"; do
		if ! which "$x" >/dev/null 2>&1 && ! pacman -Qq "$x" >/dev/null 2>&1; then
	 		hyprctl notify 4 5000 "rgb(ff0000)" "📦 $x" "u suckmust be installed for this function." && exit 1 ;
		fi
	done
}

function ubuntu {
	for x in "$@"; do
	    # Check if the command is not in the PATH and not installed via dpkg
	    if ! which "$x" >/dev/null 2>&1 && ! dpkg -s "$x" >/dev/null 2>&1; then
	        # If not found, display a notification and exit with status 1
          echo "ub"
	        hyprctl notify 4 5000 "rgb(ff0000)" "📦 $x" "must be installed for this function." && exit 1;
	    fi
	done
}

function fedora {
	for x in "$@"; do
	    # Check if the command is not in the PATH and not installed via dnf
	    if ! which "$x" >/dev/null 2>&1 && ! dnf list installed "$x" >/dev/null 2>&1; then
	        # If not found, display a notification and exit with status 1
	        hyprctl notify 4 5000 "rgb(ff0000)" "$x must be installed for this function." && exit 1;
	    fi
	done
}

function nixos {
  ERRORS=""
	for x in "$@"; do
	    # Check if the command is not in the PATH and not invokable
	    if ! which "$x" >/dev/null 2>&1 && ! command -v "$x" >/dev/null 2>&1; then
	        # If not found, display a notification and exit with status 1
          hyprctl notify 4 5000 "rgb(ff0000)" "fontsize:24 📦 $x must be installed for this function." ;
          echo '$x was not found - run "nix shell -pv $x" to install it in temporary shell'
          ERRORS=ERRORS+1
	    fi
      if "$ERRORS" <=0; then
        exit 1
      fi
	done
}


if [ "$DISTRO" = "Arch" ]; then
	arch "$@"
elif [ "$DISTRO" = "Fedora" ]; then
	fedora "$@"
elif [ "$DISTRO" == '"NixOS"' ]; then
  nixos "$@"
else
  echo "$DISTRO"
	ubuntu "$@"
fi

