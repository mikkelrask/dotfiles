#!/usr/bin/env bash

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: $0 <file-to-watch> [command-on-change]"
    exit 1
fi

FILE=$1
COMMAND=${2:-"bash \"$FILE\""} # Standardkommando er at køre filen med bash

if [ ! -f "$FILE" ]; then
    echo "Error: File '$FILE' does not exist."
    exit 1
fi

echo "Monitoring changes to '$FILE'..."
LAST_MODIFIED=$(stat -c %Y "$FILE")

# An animation array for the spinner
SPINNER=('|' '/' '-' '\')
SPINNER_INDEX=0

# Function to move cursor to bottom of screen and display waiting message
draw_waiting_message() {
    local rows
    rows=$(tput lines) # Get the number of terminal rows
    tput cup $((rows - 1)) 0 # Move cursor to the bottom line
    printf "\r[%s] waiting for changes to '%s'" "${SPINNER[SPINNER_INDEX]}" "$FILE"
}

# Initial execution of the file or command
clear
eval "$COMMAND"

while true; do
    CURRENT_MODIFIED=$(stat -c %Y "$FILE")
    if [ "$CURRENT_MODIFIED" != "$LAST_MODIFIED" ]; then
        clear
        echo "Detected changes in '$FILE'. Running command..."
        eval "$COMMAND"
        LAST_MODIFIED=$CURRENT_MODIFIED
    fi

    # Display spinner at the bottom
    SPINNER_INDEX=$(( (SPINNER_INDEX + 1) % 4 ))
    draw_waiting_message
    sleep 0.5
done
