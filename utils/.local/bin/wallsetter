#!/usr/bin/env bash

$HOME/.local/bin/ifinstalled wmenu swaybg notify-send 
[ $? -ne 0 ] && exit 1

WALLPAPERS=$(ls -R /data/appdata/motoko/wallpapers/*/*.{jpg,png})

OPTION=$(echo "$WALLPAPERS" | wmenu -i -l 10 -fn 'FantasqueSansMono Nerd Font-12' -nb '#191724' -nf '#e0def4' -sb '#ebbcba' -sf '#191724')

# Generate shuffle icon thumbnail if missing
if [[ ! -f "$SHUFFLE_ICON" ]]; then
  magick -size "${THUMBNAIL_WIDTH}x${THUMBNAIL_HEIGHT}" xc:#1e1e2e \
    \( "$SHUFFLE_ICON_SRC" -resize "80x80" \) \
    -gravity center -composite "$SHUFFLE_ICON" &>/dev/null
fi

swaybg -i "$OPTION"
notify-send -a "$(hostname)" -i "/home/mr/.config/dunst/icons/wallsetter.svg" -c info -r 2000 "wallsetter" "$OPTION is set wallpaper"

