color-link default "#daecf3"
color-link comment "#ffffff"

color-link identifier "#d3caa6"
color-link identifier.class "#d3caa6"
color-link identifier.var "#d3caa6"

color-link constant "#a2aaa7"
color-link constant.number "#97a6a2"
color-link constant.string "#a2aaa7"

color-link symbol "#a9a285"
color-link symbol.brackets "#828886"
color-link symbol.tag "#d3caa6"

color-link type "#d3caa6"
color-link type.keyword "#ffffff"

color-link special "#a2aaa7"
color-link statement "#ffffff"
color-link preproc "#97a6a2"

color-link underlined "#a2aaa7"
color-link error "bold #828886"
color-link todo "bold #ffffff"

color-link diff-added "#828886"
color-link diff-modified "#8c8c8c"
color-link diff-deleted "#272a40"

color-link gutter-error "#303450"
color-link gutter-warning "#8c8c8c"

color-link statusline "#daecf3,#040e13"
color-link tabbar "#daecf3,#040e13"

color-link indent-char "#143c50"
color-link line-number "#97a6a2"
color-link current-line-number "#d3caa6"

color-link cursor-line "#143c50,#daecf3"
color-link color-column "#143c50"
color-link type.extended "default"
